{
    "root": true,
    "env": {
        "browser": true,
        "node": true,
    },
    "globals": {
        "NodeJS": true,
        "es2020": true,
        "BigInt": true
    },
    "extends": [
        "eslint:recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
        "@typescript-eslint"
    ],
    "rules": {
        "quotes": [
            "error",
            "single"
        ],
        "semi": [
            "error",
            "always"
        ],
        "no-console": "off",
        "no-debugger": "error",
        "no-unused-vars": "off",
        "indent": "off",
        "@typescript-eslint/indent": [
            "error",
            4
        ],
        "@typescript-eslint/no-unused-vars": "error",
        "@typescript-eslint/ban-ts-comment": "off",
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-non-null-assertion": "off"
    }
}